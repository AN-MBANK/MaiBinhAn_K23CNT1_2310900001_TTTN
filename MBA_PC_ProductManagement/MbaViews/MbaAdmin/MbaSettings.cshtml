@{
    ViewData["Title"] = "Cài đặt";
}

<div class="page-header">
    <div>
        <h1>Cài đặt hệ thống</h1>
        <p>Quản lý các thiết lập cơ bản của hệ thống MBA PC.</p>
    </div>
</div>

<div class="settings-grid">

    <div class="settings-card">
        <div class="settings-card-header">
            <div class="settings-icon blue">
                ⚙
            </div>

            <div>
                <h3>Thông tin hệ thống</h3>
                <p>Thông tin chung của website quản lý sản phẩm.</p>
            </div>
        </div>

        <div class="settings-row">
            <span>Tên hệ thống</span>
            <strong>MBA PC MbaProduct Management</strong>
        </div>

        <div class="settings-row">
            <span>Phiên bản</span>
            <strong>1.0.0</strong>
        </div>

        <div class="settings-row">
            <span>Nền tảng</span>
            <strong>ASP.NET Core MVC</strong>
        </div>
    </div>

    <div class="settings-card">
        <div class="settings-card-header">
            <div class="settings-icon green">
                ✓
            </div>

            <div>
                <h3>Trạng thái hệ thống</h3>
                <p>Kiểm tra trạng thái hoạt động hiện tại.</p>
            </div>
        </div>

        <div class="status-box">
            <span class="status-dot"></span>
            <div>
                <strong>Hệ thống đang hoạt động</strong>
                <p>Website đã sẵn sàng sử dụng.</p>
            </div>
        </div>
    </div>

    <div class="settings-card">
        <div class="settings-card-header">
            <div class="settings-icon orange">
                ◈
            </div>

            <div>
                <h3>Thiết lập giao diện</h3>
                <p>Các thiết lập giao diện cơ bản.</p>
            </div>
        </div>

        <div class="settings-row">
            <span>Giao diện</span>
            <strong>Sáng</strong>
        </div>

        <div class="settings-row">
            <span>Ngôn ngữ</span>
            <strong>Tiếng Việt</strong>
        </div>

        <div class="settings-row">
            <span>Kiểu hiển thị</span>
            <strong>Quản lý dữ liệu sản phẩm</strong>
        </div>
    </div>

</div>