@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-2">Xóa sản phẩm</h1>
        <p class="text-muted mb-0">
            Xác nhận xóa sản phẩm khỏi hệ thống.
        </p>
    </div>

    <a asp-controller="MbaProducts"
       asp-action="MbaIndex"
       class="btn btn-outline-secondary">
        ← Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5 text-center">

                <div class="delete-icon mb-4">
                    <i class="bi bi-trash3"></i>
                </div>

                <h3 class="fw-bold mb-3">
                    Xác nhận xóa sản phẩm?
                </h3>

                <p class="text-muted mb-4">
                    Bạn có chắc chắn muốn xóa sản phẩm này khỏi hệ thống không?
                    Dữ liệu sau khi xóa sẽ không thể khôi phục.
                </p>

                <div class="product-preview text-start mb-4">
                    <div class="row mb-3">
                        <div class="col-5 text-muted">
                            Mã sản phẩm
                        </div>

                        <div class="col-7 fw-semibold">
                            PC001
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-5 text-muted">
                            Tên sản phẩm
                        </div>

                        <div class="col-7 fw-semibold">
                            PC Gaming MBA 01
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-5 text-muted">
                            Danh mục
                        </div>

                        <div class="col-7">
                            Máy tính bộ
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-5 text-muted">
                            Thông tin kỹ thuật
                        </div>

                        <div class="col-7 fw-semibold">
                            25.000.000đ
                        </div>
                    </div>
                </div>

                <div class="alert alert-warning text-start">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Hãy kiểm tra thông tin trước khi thực hiện thao tác xóa.
                </div>

                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a asp-controller="MbaProducts"
                       asp-action="MbaIndex"
                       class="btn btn-outline-secondary px-4">
                        Hủy
                    </a>

                    <button type="button"
                            class="btn btn-danger px-4">
                        <i class="bi bi-trash3 me-2"></i>
                        Xóa sản phẩm
                    </button>
                </div>

            </div>
        </div>

    </div>
</div>