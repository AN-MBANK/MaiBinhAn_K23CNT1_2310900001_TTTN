@model MBA_PC_ProductManagement.MbaModels.MbaCategoryItem
@{ ViewData["Title"] = "Chi tiết danh mục"; }
<div class="page-header"><div><h1>Chi tiết danh mục</h1><p>Thông tin đầy đủ của danh mục.</p></div><div class="header-actions"><a asp-action="MbaIndex" class="btn btn-outline-secondary">← Quay lại</a><a asp-action="MbaEdit" asp-route-id="@Model.MbaId" class="btn btn-primary">✎ Chỉnh sửa</a></div></div>
<div class="content-card category-detail-card"><div class="details-header"><div class="category-icon">▦</div><div><span class="category-code">@Model.MbaCode</span><h2>@Model.MbaName</h2><p>@Model.MbaDescription</p></div></div><div class="details-section"><h3>Thông tin danh mục</h3><div class="info-grid"><div class="info-item"><span>Mã</span><strong>@Model.MbaCode</strong></div><div class="info-item"><span>Trạng thái</span><strong>@(Model.MbaIsActive ? "Đang hoạt động" : "Ngừng hoạt động")</strong></div><div class="info-item"><span>Số sản phẩm</span><strong>@ViewBag.ProductCount</strong></div></div></div></div>
