@model MBA_PC_ProductManagement.MbaModels.MbaCategoryItem
@{ ViewData["Title"] = "Sửa danh mục"; }
<div class="page-header"><div><h1>Sửa danh mục</h1><p>Cập nhật thông tin nhóm sản phẩm.</p></div><a asp-action="MbaIndex" class="btn btn-outline-secondary">← Quay lại</a></div>
<div class="content-card"><form asp-action="MbaEdit" method="post">@Html.AntiForgeryToken()<input asp-for="MbaId" type="hidden" /><div class="form-grid"><div class="form-group"><label>Mã danh mục</label><input asp-for="MbaCode" class="form-control" /></div><div class="form-group"><label>Tên danh mục</label><input asp-for="MbaName" class="form-control" required /></div><div class="form-group full-width"><label>Mô tả</label><textarea asp-for="MbaDescription" class="form-control" rows="4"></textarea></div><div class="form-group"><label>Trạng thái</label><select asp-for="MbaIsActive" class="form-select"><option value="true">Đang hoạt động</option><option value="false">Ngừng hoạt động</option></select></div></div><div class="form-actions mt-4"><a asp-action="MbaIndex" class="btn btn-outline-secondary">Hủy</a><button class="btn btn-primary" type="submit">✓ Lưu thay đổi</button></div></form></div>
