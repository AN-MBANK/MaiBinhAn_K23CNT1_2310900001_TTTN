@model IEnumerable<MBA_PC_ProductManagement.MbaModels.MbaCategoryItem>
@{
    ViewData["Title"] = "Danh mục sản phẩm";
}
<div class="categories-page">
    <div class="page-heading">
        <div>
            <span class="profile-eyebrow">PRODUCT CATEGORIES</span>
            <h1 class="page-title">Danh mục sản phẩm</h1>
            <p class="page-description">Quản lý nhóm sản phẩm và theo dõi số lượng dữ liệu theo từng danh mục.</p>
        </div>
        <a asp-action="MbaCreate" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm danh mục</a>
    </div>

    @if (TempData["CategoryMessage"] != null)
    {
        <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>@TempData["CategoryMessage"]</div>
    }

    <div class="category-overview">
        <div class="category-overview-item">
            <span class="category-overview-icon"><i class="bi bi-tags"></i></span>
            <div><small>Tổng danh mục</small><strong>@Model.Count()</strong></div>
        </div>
        <div class="category-overview-item">
            <span class="category-overview-icon green"><i class="bi bi-box-seam"></i></span>
            <div><small>Tổng sản phẩm</small><strong>@(ViewBag.TotalProducts ?? 0)</strong></div>
        </div>
        <div class="category-overview-item">
            <span class="category-overview-icon orange"><i class="bi bi-bar-chart"></i></span>
            <div><small>Danh mục đang dùng</small><strong>@(ViewBag.UsedCategories ?? 0)</strong></div>
        </div>
    </div>

    <div class="content-card category-management-card">
        <div class="content-card-header">
            <div><h5>Danh sách danh mục</h5><p>Thông tin được trình bày dạng bảng để quản lý nhanh và không bị chật.</p></div>
            <span class="count-badge">@Model.Count() danh mục</span>
        </div>
        <div class="table-responsive">
            <table class="table align-middle category-management-table">
                <thead>
                    <tr><th>Mã</th><th>Danh mục</th><th>Mô tả</th><th>Sản phẩm</th><th>Trạng thái</th><th>Thao tác</th></tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    var productCounts = ViewBag.ProductCounts as IDictionary<int, int> ?? new Dictionary<int, int>();
                    var productCount = productCounts.TryGetValue(c.MbaId, out var count) ? count : 0;
                    <tr>
                        <td><span class="category-code-badge">@c.MbaCode</span></td>
                        <td><div class="category-name-cell"><span class="category-table-icon"><i class="bi bi-grid-3x3-gap"></i></span><strong>@c.MbaName</strong></div></td>
                        <td><span class="category-description">@c.MbaDescription</span></td>
                        <td><span class="product-count-pill">@productCount sản phẩm</span></td>
                        <td><span class="category-status @(c.MbaIsActive ? "active" : "inactive")"><i class="bi bi-circle-fill"></i>@(c.MbaIsActive ? "Đang hoạt động" : "Ngừng hoạt động")</span></td>
                        <td>
                            <div class="category-table-actions">
                                <a asp-action="MbaDetails" asp-route-id="@c.MbaId" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                <a asp-action="MbaEdit" asp-route-id="@c.MbaId" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a>
                                <form asp-action="MbaDelete" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.MbaId" /><button type="submit" title="Xóa"><i class="bi bi-trash"></i></button></form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
