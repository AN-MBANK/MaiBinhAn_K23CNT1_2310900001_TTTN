@{
    ViewData["Title"] = "Danh mục sản phẩm";
    Layout = "~/MbaViews/MbaUser/_MbaUserLayout.cshtml";
}
<section class="content-page">
    <div class="container">
        <div class="page-hero">
            <div>
                <span class="profile-eyebrow">PRODUCT CATEGORIES</span>
                <h1>Danh mục sản phẩm</h1>
                <p>Phân loại sản phẩm theo từng nhóm linh kiện máy tính.</p>
            </div>
