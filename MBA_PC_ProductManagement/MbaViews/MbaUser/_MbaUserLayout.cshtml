@{
    Layout = null;
    var isEmployee = Context.Session.GetString("IsEmployee") == "true";
    var isAdmin = Context.Session.GetString("MbaIsAdmin") == "true";
    var isLoggedIn = isEmployee || isAdmin;
    var displayName = Context.Session.GetString("UserName") ?? (isAdmin ? "admin" : "Khách");
    var displayRole = Context.Session.GetString("UserRole") ?? (isAdmin ? "Admin" : "Khách");
    var avatarLetter = string.IsNullOrWhiteSpace(displayName) ? "U" : displayName.Substring(0, 1).ToUpperInvariant();
    var avatarUrl = Context.Session.GetString("MbaAvatarUrl");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MBA PC Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mba-user.css" />
</head>
<body>
    <header class="main-header">
        <div class="container">
            <nav class="navbar navbar-expand-lg navbar-dark">
                <a class="navbar-brand fw-bold" asp-controller="MbaUser" asp-action="MbaIndex">
                    <i class="bi bi-pc-display-horizontal me-2"></i>
                    MBA PC MANAGEMENT
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainMenu">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="MbaUser" asp-action="MbaIndex">
                                <i class="bi bi-house-door me-1"></i>Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="MbaUser" asp-action="MbaReview">
                                <i class="bi bi-grid-3x3-gap me-1"></i>Danh sách sản phẩm
                            </a>
                        </li>
                        @if (isEmployee)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MbaUser" asp-action="MbaAssignments">
                                    <i class="bi bi-clipboard-check me-1"></i>Công việc được giao
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="MbaUser" asp-action="MbaCategories">
                                <i class="bi bi-tags me-1"></i>Danh mục
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="MbaUser" asp-action="MbaAbout">
                                <i class="bi bi-info-circle me-1"></i>Giới thiệu
                            </a>
                        </li>

                        @if (isLoggedIn)
                        {
                            <li class="nav-item dropdown ms-lg-3">
                                <a class="nav-link user-menu-toggle d-flex align-items-center gap-2"
                                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-avatar">@if (!string.IsNullOrWhiteSpace(avatarUrl)) { <img src="@avatarUrl" alt="Ảnh đại diện" /> } else { @avatarLetter }</span>
                                    <span class="user-menu-text">
                                        <strong>@displayName</strong>
                                        <small>@displayRole</small>
                                    </span>
                                    <i class="bi bi-chevron-down"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                                    <li class="dropdown-header">
                                        <div class="fw-bold">@displayName</div>
                                        <small>@displayRole</small>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    @if (isEmployee)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="MbaUser" asp-action="MbaProfile">
                                                <i class="bi bi-person-circle me-2"></i>Hồ sơ cá nhân
                                            </a>
                                        </li>
                                    }
                                    @if (isAdmin)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="MbaAdmin" asp-action="MbaIndex">
                                                <i class="bi bi-speedometer2 me-2"></i>Trang quản trị
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <form asp-controller="MbaAccount" asp-action="MbaLogout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-outline-light btn-sm" asp-controller="MbaAccount" asp-action="MbaLogin">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="container">
            <div class="row gy-3">
                <div class="col-md-6">
                    <h5><i class="bi bi-pc-display-horizontal me-2"></i>MBA PC MANAGEMENT</h5>
                    <p>Hệ thống quản lý và tra cứu thông tin sản phẩm máy tính.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-1">Hệ thống phục vụ rà soát và chuẩn hóa dữ liệu sản phẩm.</p>
                    <small>© @DateTime.Now.Year MBA PC Management</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
