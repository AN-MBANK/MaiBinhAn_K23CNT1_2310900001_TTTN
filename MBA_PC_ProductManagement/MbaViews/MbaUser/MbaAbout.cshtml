@{
    ViewData["Title"] = "Giới thiệu";
    Layout = "~/MbaViews/MbaUser/_MbaUserLayout.cshtml";
}
<section class="content-page about-page">
    <div class="container">
        <div class="page-hero">
            <div>
                <span class="profile-eyebrow">ABOUT SYSTEM</span>
                <h1>Giới thiệu hệ thống</h1>
                <p>Thông tin tổng quan về MBA PC Management và mục tiêu quản lý dữ liệu sản phẩm.</p>
            </div>
            <span class="page-hero-icon"><i class="bi bi-info-circle"></i></span>
        </div>

        <div class="about-grid">
            <article class="about-main-card">
                <div class="about-icon"><i class="bi bi-pc-display-horizontal"></i></div>
                <h2>MBA PC Management</h2>
                <p>MBA PC Management là hệ thống hỗ trợ quản lý, phân loại, rà soát và chuẩn hóa dữ liệu sản phẩm máy tính.</p>
                <p>Giao diện nhân viên tập trung vào việc tra cứu và theo dõi thông tin sản phẩm, trong khi các chức năng quản trị được tách riêng cho tài khoản MbaAdmin.</p>
            </article>
            <div class="about-side">
                <div class="about-info-card"><i class="bi bi-database-check"></i><div><strong>Chuẩn hóa dữ liệu</strong><span>Hỗ trợ theo dõi chất lượng và trạng thái dữ liệu sản phẩm.</span></div></div>
                <div class="about-info-card"><i class="bi bi-search"></i><div><strong>Tra cứu thuận tiện</strong><span>Tổ chức thông tin theo sản phẩm và danh mục.</span></div></div>
                <div class="about-info-card"><i class="bi bi-shield-check"></i><div><strong>Phân quyền</strong><span>MbaEmployee và MbaAdmin có các khu vực chức năng riêng.</span></div></div>
            </div>
        </div>
    </div>
</section>
