@model MBA_PC_ProductManagement.MbaModels.MbaProduct
@{
    ViewData["Title"] = "Chi tiết dữ liệu";
    Layout = "~/MbaViews/MbaUser/_MbaUserLayout.cshtml";
}
<section class="content-page"><div class="container">
<div class="page-hero"><div><span class="profile-eyebrow">PRODUCT RECORD</span><h1>@Model.MbaName</h1><p>@Model.MbaCode · @Model.MbaCategory · @Model.MbaBrand</p></div><span class="page-hero-icon"><i class="bi bi-box-seam"></i></span></div>
<div class="content-card"><div class="details-section"><h3>Thông tin dữ liệu</h3><div class="info-grid"><div class="info-item"><span>Mã</span><strong>@Model.MbaCode</strong></div><div class="info-item"><span>Danh mục</span><strong>@Model.MbaCategory</strong></div><div class="info-item"><span>Thương hiệu</span><strong>@Model.MbaBrand</strong></div><div class="info-item"><span>Giá</span><strong>@(Model.MbaPrice==0?"Chưa có":Model.MbaPrice.ToString("N0")+" ₫")</strong></div><div class="info-item"><span>Số lượng</span><strong>@Model.MbaQuantity</strong></div><div class="info-item"><span>Trạng thái</span><strong>@Model.MbaDataStatus</strong></div></div></div><div class="details-section"><h3>Thông tin kỹ thuật</h3><p class="description">@Model.MbaTechnicalInfo</p></div><div class="details-section"><h3>Mô tả</h3><p class="description">@Model.MbaDescription</p></div></div>
</div></section>
