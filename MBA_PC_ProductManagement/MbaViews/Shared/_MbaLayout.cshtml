@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var adminName = Context.Session.GetString("UserName") ?? "admin";
    var adminRole = Context.Session.GetString("UserRole") ?? "Admin";
    var adminLetter = string.IsNullOrWhiteSpace(adminName) ? "A" : adminName.Substring(0, 1).ToUpperInvariant();
    var adminAvatarUrl = Context.Session.GetString("MbaAvatarUrl");
    bool MbaIsActive(string controller, string? action = null)
    {
        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)) return false;
        return action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MBA-PC ProductManagement</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/mba-site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mba-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mba-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mba-products.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mba-categories.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand-block">
            <div class="brand-mark">MBA</div>
            <div>
                <div class="brand-name">MBA-PC</div>
                <div class="brand-subtitle">ProductManagement</div>
            </div>
        </div>

        <div class="menu-label">TỔNG QUAN</div>
        <nav class="sidebar-nav">
            <a asp-controller="MbaAdmin" asp-action="MbaIndex" class="sidebar-link @(MbaIsActive("MbaAdmin", "MbaIndex") ? "active" : "")">
                <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
            </a>
            <a asp-controller="MbaProducts" asp-action="MbaIndex" class="sidebar-link @(MbaIsActive("MbaProducts") ? "active" : "")">
                <i class="bi bi-table"></i><span>Danh sách sản phẩm</span>
            </a>
            <a asp-controller="MbaAdmin" asp-action="MbaSearch" class="sidebar-link @(MbaIsActive("MbaAdmin", "MbaSearch") ? "active" : "")">
                <i class="bi bi-search"></i><span>Tìm kiếm dữ liệu</span>
            </a>
            </nav>

        <div class="menu-label">KIỂM TRA DỮ LIỆU</div>
        <nav class="sidebar-nav">
            <a asp-controller="MbaAdmin" asp-action="MbaReviewData" class="sidebar-link @(MbaIsActive("MbaAdmin", "MbaReviewData") ? "active" : "")">
                <i class="bi bi-clipboard-check"></i><span>Rà soát dữ liệu</span>
            </a>
            <a asp-controller="MbaAdmin" asp-action="MbaStandardizeData" class="sidebar-link @(MbaIsActive("MbaAdmin", "MbaStandardizeData") ? "active" : "")">
                <i class="bi bi-check2-square"></i><span>Chuẩn hóa dữ liệu</span>
            </a>
            <a asp-controller="MbaAdmin" asp-action="MbaInvalidData" class="sidebar-link @(MbaIsActive("MbaAdmin", "MbaInvalidData") ? "active" : "")">
                <i class="bi bi-exclamation-triangle"></i><span>Dữ liệu không hợp lệ</span>
            </a>
            <a asp-controller="MbaAdmin" asp-action="MbaAssignmentMonitor" class="sidebar-link @(MbaIsActive("MbaAdmin", "MbaAssignmentMonitor") ? "active" : "")">
                <i class="bi bi-people-fill"></i><span>Theo dõi phân công</span>
            </a>
        </nav>

        <div class="menu-label">QUẢN TRỊ</div>
        <nav class="sidebar-nav">
            <a asp-controller="MbaCategories" asp-action="MbaIndex" class="sidebar-link @(MbaIsActive("MbaCategories") ? "active" : "")"><i class="bi bi-tags"></i><span>Danh mục</span></a>
            <a asp-controller="MbaAdmin" asp-action="MbaEmployees" class="sidebar-link @(MbaIsActive("MbaAdmin", "MbaEmployees") ? "active" : "")"><i class="bi bi-people"></i><span>Quản lý nhân viên</span></a>
            <a asp-controller="MbaAdmin" asp-action="MbaSettings" class="sidebar-link @(MbaIsActive("MbaAdmin", "MbaSettings") ? "active" : "")"><i class="bi bi-gear"></i><span>Quản lý hệ thống</span></a>
            </nav>

        <div class="sidebar-logout"><form asp-controller="MbaAccount" asp-action="MbaLogout" method="post" class="m-0"><button type="submit" class="btn btn-outline-light w-100"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button></form></div>

        <div class="sidebar-user admin-user-menu">
            <div class="avatar">@if (!string.IsNullOrWhiteSpace(adminAvatarUrl)) { <img src="@adminAvatarUrl" alt="Ảnh đại diện" /> } else { @adminLetter }</div>
            <div class="user-text"><strong>@adminName</strong><small>@adminRole</small></div>
            <a asp-controller="MbaAdmin" asp-action="MbaProfile" class="user-profile-link" title="Hồ sơ quản trị viên">
                <i class="bi bi-three-dots-vertical"></i>
            </a>
        </div>
    </aside>

    <div class="main-panel">
        <header class="topbar">
            <div>
                <div class="breadcrumb-text">MBA-PC ProductManagement / @ViewData["Title"]</div>
                <h1 class="topbar-title">Hệ thống quản lý sản phẩm PC</h1>
            </div>
            <div class="topbar-actions">
                <span class="system-status"><span></span> Hệ thống hoạt động</span>
                <button class="icon-button" type="button" title="Thông báo"><i class="bi bi-bell"></i></button>
                <div class="dropdown">
                    <button class="top-account dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="top-avatar">@if (!string.IsNullOrWhiteSpace(adminAvatarUrl)) { <img src="@adminAvatarUrl" alt="Ảnh đại diện" /> } else { @adminLetter }</span>
                        <span class="top-account-text"><strong>@adminName</strong><small>@adminRole</small></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li class="dropdown-header"><strong>@adminName</strong><br /><small>@adminRole</small></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="MbaAdmin" asp-action="MbaProfile"><i class="bi bi-person-circle me-2"></i>Hồ sơ cá nhân</a></li>
                        <li>
                            <form asp-controller="MbaAccount" asp-action="MbaLogout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="content-area">@RenderBody()</main>
        <footer class="main-footer">© 2026 MBA-PC ProductManagement <span>Hệ thống quản lý và chuẩn hóa dữ liệu sản phẩm</span></footer>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/mba-site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
